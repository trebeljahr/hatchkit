{
  "name": "@hatchkit/dev-plugin-vite",
  "version": "0.3.1",
  "description": "Vite plugin for hatchkit's local-dev integration. Writes the project's Caddy fragment on dev startup, replaces Vite's Local/Network URL banner with Local/Tailscale.",
  "license": "MIT",
  "author": "Rico Trebeljahr",
  "homepage": "https://hatchkit.trebeljahr.com/",
  "bugs": {
    "url": "https://github.com/trebeljahr/hatchkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/hatchkit.git",
    "directory": "packages/dev-plugin-vite"
  },
  "funding": "https://ricos.site/donate?from=hatchkit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hatchkit/dev-shared": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21"
  }
}
