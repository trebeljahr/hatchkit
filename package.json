{
  "name": "hatchkit-monorepo",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "private": true,
  "description": "Interactive CLI for scaffolding full-stack projects with composable ML services",
  "license": "MIT",
  "homepage": "https://hatchkit.trebeljahr.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/hatchkit.git"
  },
  "bugs": {
    "url": "https://github.com/trebeljahr/hatchkit/issues"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "coolify",
    "hetzner",
    "terraform",
    "dotenvx",
    "mcp",
    "mlops"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter @hatchkit/dev-shared --filter @hatchkit/dev-plugin-next --filter @hatchkit/dev-plugin-vite --filter @hatchkit/mcp run build && pnpm --filter hatchkit run build",
    "predev": "pnpm --filter @hatchkit/dev-shared run build",
    "dev": "concurrently -n shared,docs,cli,mcp -c blue,cyan,magenta,yellow \"pnpm --filter @hatchkit/dev-shared run dev\" \"pnpm -C docs run dev\" \"pnpm -C cli run dev:typecheck\" \"pnpm -C mcp run dev:typecheck\"",
    "dev:docs": "pnpm -C docs run dev",
    "dev:cli": "pnpm --filter hatchkit run dev",
    "start": "pnpm --filter hatchkit run start",
    "create": "pnpm --filter hatchkit run start",
    "typecheck": "pnpm --filter hatchkit run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "check": "pnpm --filter hatchkit run check",
    "install-local": "pnpm --filter hatchkit run install-local",
    "changelog": "pnpm --filter hatchkit run changelog",
    "release": "node cli/scripts/release.mjs patch",
    "release:patch": "node cli/scripts/release.mjs patch",
    "release:minor": "node cli/scripts/release.mjs minor",
    "release:major": "node cli/scripts/release.mjs major",
    "release:resume": "node cli/scripts/release.mjs resume",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "keytar",
      "sharp"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
