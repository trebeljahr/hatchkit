{
  "name": "hatchkit-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "fumadocs-mdx && next dev --port 3737",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.8.9",
    "fumadocs-mdx": "15.0.2",
    "fumadocs-ui": "16.8.9",
    "next": "16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "mdast-util-to-markdown": "2.1.2"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
