/*
 * tests/support/memory-membership.ts — an in-memory stand-in for the four
 * collections the membership service writes.
 *
 * The point of this file is that the tests around it drive the REAL
 * service functions. Rules 1 and 2 are entirely about the ORDER of two
 * writes and about what a crash between them leaves behind; a test
 * against a hand-rolled fake service would assert the fake's ordering and
 * pass forever while the real one regressed. So the seam is placed as
 * deep as it can go — underneath `mirror.ts`, at the two places it
 * actually reaches storage:
 *
 *   1. `mongoose.connection.db.collection(name)`, for better-auth's
 *      `member`, `organization`, `invitation`, `session` and `user` rows.
 *   2. The `WorkspaceMember` model's statics, for the app's own mirror.
 *
 * Everything above those two lines — every query, every filter, every
 * write order, every last-owner count — is the shipped code being
 * evaluated for real, with no database and no network.
 *
 * Three things the tests need and a database would not give them:
 *
 *   - an operation LOG, in order, so "mirror last on a grant, mirror
 *     first on a removal" is a direct assertion rather than an inference;
 *   - `failWriteAt(n)`, which makes any single write throw, so a test can
 *     crash the process mid-operation at every step in turn;
 *   - `reseed()`, so each of those crash runs starts from the same state.
 *
 * An unmodelled query operator or update operator throws instead of being
 * ignored. A fake that quietly returns "no match" for a filter it does not
 * understand turns a real permission bug into a green test.
 */

import mongoose from "mongoose";
import {
  capabilitiesForRole,
  normalizeRole,
  type WorkspaceMembership,
} from "@starter/shared";
import { WorkspaceMember } from "../../models/WorkspaceMember.js";

/* ── The seeded fixture ─────────────────────────────────────────────── */

