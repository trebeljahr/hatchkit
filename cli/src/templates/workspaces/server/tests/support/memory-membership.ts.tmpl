export const WORKSPACE_ID = "ws-alpha";
/** A second workspace `MEMBER` also belongs to, joined later than alpha. */
export const SECOND_WORKSPACE_ID = "ws-beta";
/** A workspace nobody from alpha is in — the cross-tenant fixture. */
