/*
 * index.ts — the membership service's public surface.
 *
 * Everything outside this directory imports from here and from nowhere
 * else inside it. The re-exports are explicit rather than a `export *`
 * so adding a function to a module is a deliberate act: a helper that
 * writes `WorkspaceMember`, `member`, `organization` or `invitation` is
 * not supposed to become reachable from a router by accident.
 *
 * Nothing outside `services/membership/` writes those four collections.
 * That is the whole reason this directory exists.
 */

export {
  MembershipError,
  badRequest,
  forbidden,
  notFound,
  tooManyRequests,
