[Unit]
Description=Quick Hatchkit host integrity check
Wants=network-online.target
After=network-online.target docker.service
OnFailure=hatchkit-host-integrity-quick-failed.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/host-integrity.py check --quick
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=512M
TimeoutStartSec=4min
PrivateTmp=true
ProtectHome=read-only
NoNewPrivileges=true
