[Unit]
Description=Mail that the quick Hatchkit host integrity check did not finish
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/host-integrity.py failed --quick
User=root
UMask=0077
TimeoutStartSec=5min
MemoryMax=128M
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
