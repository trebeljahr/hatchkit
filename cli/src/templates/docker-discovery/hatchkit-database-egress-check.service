[Unit]
Description=Check reviewed database destination protection
After=docker.service hatchkit-database-egress.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/database-egress.py check
Environment=PYTHONPYCACHEPREFIX=/var/cache/hatchkit-security/python
User=root
UMask=0077
TimeoutStartSec=90s
CPUQuota=25%
MemoryMax=128M
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true
