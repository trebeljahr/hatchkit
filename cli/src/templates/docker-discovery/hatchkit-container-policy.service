[Unit]
Description=Check reviewed container containment and discovery controls
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/container-policy.py
Environment=PYTHONPYCACHEPREFIX=/var/cache/hatchkit-security/python
User=root
UMask=0077
CPUQuota=25%
MemoryMax=256M
TimeoutStartSec=90s
NoNewPrivileges=true
ProtectHome=read-only
PrivateTmp=true
