[Unit]
Description=Hatchkit update watch (shared service versions against upstream security advisories)
Wants=network-online.target
After=network-online.target docker.service
OnFailure=hatchkit-update-watch-failed.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/update-watch.py check
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
# docker inspect, a few docker exec version reads and ~15 GitHub requests.
TimeoutStartSec=15min
PrivateTmp=true
ProtectHome=read-only
NoNewPrivileges=true
