[Unit]
Description=Mail that the final deployed image scan did not finish
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/update-watch.py failed --failed-unit hatchkit-image-vulnerabilities.service
User=root
UMask=0077
TimeoutStartSec=5min
MemoryMax=128M
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
