[Unit]
Description=Rebuild opted-in app images on a fresh base image when the scanner reports fixes
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# No opt-in file, no pass: installing the unit enables nothing.
ExecCondition=/usr/bin/test -f /etc/hatchkit-security/image-rebuilds.json
ExecStart=/usr/bin/python3 /opt/hatchkit-backups/image-rebuilds.py run
User=root
UMask=0077
Nice=10
TimeoutStartSec=5min
MemoryMax=256M
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
