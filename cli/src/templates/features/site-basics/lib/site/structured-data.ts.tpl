/*
 * Generated by hatchkit. `hatchkit update` rewrites this file, so an edit
 * here is lost on the next run. Pass changes to `<SiteJsonLd />` in the root
 * layout instead; every option below is merged over the defaults.
 *
 * The site's schema.org description, as one JSON-LD graph: the WebSite, the
 * Organization behind it, and — for an app — the SoftwareApplication. The
 * nodes point at each other by `@id`, so a search engine reads them as one
 * entity rather than three unrelated claims.
 */

import { SITE } from "./config";

export type JsonLdNode = Record<string, unknown>;

export interface SiteStructuredDataOptions {
  /** Merged into the WebSite node. */
  website?: JsonLdNode;
  /** Merged into the Organization node: a `logo`, `sameAs` profile links, a
   *  legal `name` that differs from the product's. */
  organization?: JsonLdNode;
  /** Merged into the SoftwareApplication node, or `false` to leave it out.
   *  The node exists only when the site is an app (`SITE.kind`). Google's
   *  rich result also wants `offers` and a rating: add them only when they
   *  are real. */
  application?: JsonLdNode | false;
}

export function siteStructuredData(options: SiteStructuredDataOptions = {}): JsonLdNode {
  const home = `${SITE.url}/`;
  const organization = `${home}#organization`;
  const described = SITE.description ? { description: SITE.description } : {};
  const nodes: JsonLdNode[] = [
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      url: home,
      name: SITE.name,
      ...described,
      publisher: { "@id": organization },
      ...options.website,
    },
    {
      "@type": "Organization",
      "@id": organization,
      url: home,
      name: SITE.name,
      ...options.organization,
    },
  ];
  if (SITE.kind === "app" && options.application !== false) {
    nodes.push({
      "@type": "SoftwareApplication",
      "@id": `${home}#application`,
      url: home,
      name: SITE.name,
      ...described,
      operatingSystem: SITE.operatingSystems.join(", "),
      publisher: { "@id": organization },
      ...options.application,
    });
  }
  return { "@context": "https://schema.org", "@graph": nodes };
}

/** The body of a `<script type="application/ld+json">`. Every `<` is
 *  escaped, so a value that contains "</script>" cannot end the element. */
export function jsonLdText(data: JsonLdNode): string {
  return JSON.stringify(data).replace(/</g, "\\u003c");
}
