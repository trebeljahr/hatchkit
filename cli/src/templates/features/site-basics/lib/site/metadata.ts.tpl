/*
 * Generated by hatchkit. `hatchkit update` rewrites this file, so an edit
 * here is lost on the next run. Change one page in that page, with
 * `pageMetadata()`; change the whole site in the root layout's own metadata,
 * which `withSiteMetadata()` puts over every default below.
 *
 * Two Next.js behaviours this module exists to get right:
 *
 *   · `openGraph`, `twitter` and `alternates` merge SHALLOWLY. A page that
 *     sets `openGraph: { title }` replaces the layout's whole `openGraph`
 *     object, and its card silently loses the image, the site name and the
 *     URL. `pageMetadata()` always returns the whole object.
 *   · A page that sets no canonical inherits the layout's. A literal "/" in
 *     the root layout would tell search engines that every page is a copy of
 *     the home page. "./" is resolved against each page's own path, so every
 *     page is its own canonical, with the trailing slash the app is built
 *     with.
 */

import type { Metadata } from "next";
import { SITE } from "./config";

type OpenGraph = NonNullable<Metadata["openGraph"]>;
type Twitter = NonNullable<Metadata["twitter"]>;

export interface SocialImage {
  url: string;
  width?: number;
  height?: number;
  alt?: string;
}

/** The default social card. Replace public/og.png to change it everywhere. */
export const DEFAULT_SOCIAL_IMAGE: SocialImage = {
  url: SITE.ogImage,
  width: 1200,
  height: 630,
  alt: SITE.name,
};

function titleText(title: Metadata["title"]): string | undefined {
  if (typeof title === "string") return title;
  if (title !== null && typeof title === "object") {
    if ("absolute" in title && typeof title.absolute === "string") return title.absolute;
    if ("default" in title && typeof title.default === "string") return title.default;
  }
  return undefined;
}

function described(description: string | null | undefined): { description?: string } {
  return description ? { description } : {};
}

/**
 * The root layout's metadata: the site's defaults under the layout's own.
 *
 * Every field the layout sets wins. The social card's title and description
 * follow the layout's `title` and `description` when it sets them, so the
 * card and the tab never disagree.
 */
export function withSiteMetadata(own: Metadata = {}): Metadata {
  const title = own.title ?? { default: SITE.name, template: `%s | ${SITE.name}` };
  const shareTitle = titleText(title) ?? SITE.name;
  const description = own.description ?? (SITE.description || null);
  return {
    applicationName: SITE.name,
    ...own,
    metadataBase: own.metadataBase ?? new URL(SITE.url),
    title,
    description,
    alternates: { canonical: "./", ...own.alternates },
    openGraph: {
      type: "website",
      siteName: SITE.name,
      url: "./",
      title: shareTitle,
      ...described(description),
      images: [DEFAULT_SOCIAL_IMAGE],
      ...own.openGraph,
    } as OpenGraph,
    twitter: {
      card: "summary_large_image",
      title: shareTitle,
      ...described(description),
      images: [DEFAULT_SOCIAL_IMAGE.url],
      ...own.twitter,
    } as Twitter,
  };
}

export interface PageMetadataInput {
  /** The page's own title. The layout's template adds the site name in the
   *  tab; the social card gets this alone, next to `og:site_name`. */
  title?: string;
  /** Defaults to the site's description. */
  description?: string;
  /** A served path or a full URL. Defaults to the site's social card. */
  image?: string | SocialImage;
  /** Keep the page out of search results. The sitemap leaves it out too. */
  noIndex?: boolean;
  /** Only for a page reachable at more than one address: the address to
   *  index, as a path ("/pricing/") or a full URL. Defaults to the page's
   *  own address. */
  canonical?: string;
  /** Anything else, merged over the result. `openGraph`, `twitter` and
   *  `alternates` are merged one level deep, so the card keeps its image. */
  extra?: Metadata;
}

/**
 * One page's metadata, complete: title, description, canonical, and the
 * whole social card, so nothing is lost to the shallow merge.
 *
 *   export const metadata = pageMetadata({
 *     title: "Pricing",
 *     description: "What it costs, and what you get.",
 *   });
 */
export function pageMetadata(page: PageMetadataInput = {}): Metadata {
  const extra = page.extra ?? {};
  const description = page.description ?? (SITE.description || undefined);
  const shareTitle = page.title ?? SITE.name;
  const image =
    typeof page.image === "string" ? { url: page.image } : (page.image ?? DEFAULT_SOCIAL_IMAGE);
  const url = page.canonical ?? "./";
  return {
    ...extra,
    ...(page.title !== undefined ? { title: page.title } : {}),
    ...(page.description !== undefined ? { description: page.description } : {}),
    alternates: { canonical: url, ...extra.alternates },
    openGraph: {
      type: "website",
      siteName: SITE.name,
      url,
      title: shareTitle,
      ...described(description),
      images: [image],
      ...extra.openGraph,
    } as OpenGraph,
    twitter: {
      card: "summary_large_image",
      title: shareTitle,
      ...described(description),
      images: [image.url],
      ...extra.twitter,
    } as Twitter,
    ...(page.noIndex ? { robots: { index: false, follow: true } } : {}),
  };
}
