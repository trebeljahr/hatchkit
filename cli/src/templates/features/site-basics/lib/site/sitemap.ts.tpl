/*
 * Generated by hatchkit. `hatchkit update` rewrites this file, so an edit
 * here is lost on the next run. Add entries in app/sitemap.ts instead.
 *
 * The sitemap is read off the app directory at build time, so a new page is
 * in it on the next build with nothing to register. What counts as public:
 *
 *   · every folder with a page file, under its URL;
 *   · route groups are transparent — except (protected), which is never in;
 *   · never `_private` folders, `@slot`s, intercepting routes, `api`, or a
 *     `[param]` segment (there is no list of its values to read — add those
 *     pages in app/sitemap.ts);
 *   · never sign-in and its relatives (NOT_IN_SITEMAP);
 *   · never a page, or a folder under a layout, whose source says
 *     `index: false` or `noIndex: true` — so the sitemap and the page's own
 *     robots tag cannot disagree.
 *
 * `next build` runs in the client package, which is what the path below is
 * relative to. The routes are written once, into the static sitemap.xml;
 * nothing reads the folder at run time.
 */

import { type Dirent, readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";
import type { MetadataRoute } from "next";
import { SITE } from "./config";

const APP_DIR = join(/* turbopackIgnore: true */ process.cwd(), __HATCHKIT_APP_DIR__);

/** Matches `trailingSlash` in next.config, so each URL is the one served. */
const TRAILING_SLASH = __HATCHKIT_TRAILING_SLASH__;

/** Route groups whose pages are never public. */
const PRIVATE_GROUPS: ReadonlySet<string> = new Set(["(protected)"]);

/** Public pages with nothing on them worth finding. */
export const NOT_IN_SITEMAP: ReadonlySet<string> = new Set([
  "/login",
  "/signup",
  "/forgot-password",
  "/reset-password",
]);

const PAGE_FILE = /^page\.(?:tsx|ts|jsx|js|mdx|md)$/;
const LAYOUT_FILE = /^layout\.(?:tsx|ts|jsx|js)$/;
const NO_INDEX = /\bindex\s*:\s*false\b|\bnoIndex\s*:\s*true\b/;

/** An absolute URL on this site, for a path such as "/pricing/". */
export function absoluteUrl(path: string): string {
  return `${SITE.url}${path.startsWith("/") ? path : `/${path}`}`;
}

function declaresNoIndex(file: string): boolean {
  return NO_INDEX.test(readFileSync(/* turbopackIgnore: true */ file, "utf-8"));
}

function isSkipped(name: string): boolean {
  return (
    name.startsWith("_") ||
    name.startsWith("@") ||
    name.startsWith("[") ||
    name.startsWith("(.") ||
    name === "api" ||
    name === "node_modules"
  );
}

/** Every public page's path, "/" first. */
export function publicRoutes(appDir: string = APP_DIR): string[] {
  const routes = new Set<string>();
  const walk = (dir: string, segments: readonly string[]): void => {
    let entries: Dirent[];
    try {
      entries = readdirSync(/* turbopackIgnore: true */ dir, { withFileTypes: true });
    } catch {
      return;
    }
    const layout = entries.find((e) => e.isFile() && LAYOUT_FILE.test(e.name));
    if (layout && declaresNoIndex(join(dir, layout.name))) return;
    const page = entries.find((e) => e.isFile() && PAGE_FILE.test(e.name));
    const bare = segments.length === 0 ? "/" : `/${segments.join("/")}`;
    if (page && !NOT_IN_SITEMAP.has(bare) && !declaresNoIndex(join(dir, page.name))) {
      routes.add(segments.length === 0 || !TRAILING_SLASH ? bare : `${bare}/`);
    }
    for (const entry of entries) {
      if (!entry.isDirectory() || isSkipped(entry.name)) continue;
      const group = entry.name.startsWith("(") && entry.name.endsWith(")");
      if (group && PRIVATE_GROUPS.has(entry.name)) continue;
      walk(join(dir, entry.name), group ? segments : [...segments, entry.name]);
    }
  };
  walk(appDir, []);
  return [...routes].sort();
}

/** The sitemap: every public page, then `extra` (a URL already listed is
 *  not listed twice). */
export function siteSitemap(extra: MetadataRoute.Sitemap = []): MetadataRoute.Sitemap {
  const entries: MetadataRoute.Sitemap = publicRoutes().map((path) => ({ url: absoluteUrl(path) }));
  const seen = new Set(entries.map((entry) => entry.url));
  for (const entry of extra) {
    if (seen.has(entry.url)) continue;
    seen.add(entry.url);
    entries.push(entry);
  }
  return entries;
}
