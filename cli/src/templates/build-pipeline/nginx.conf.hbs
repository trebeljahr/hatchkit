# nginx config for {{name}}'s static image. The Dockerfile copies it
# over the stock /etc/nginx/conf.d/default.conf.
#
# The stock config maps a URL straight onto a file and does nothing
# else. That breaks the two shapes a static build comes in:
#   · a single-page app routes on the client, so a reload on
#     `/settings` asks nginx for a file that doesn't exist → 404;
#   · a build that writes `about.html` (clean URLs) 404s on `/about`.
{{#if spaFallback}}
#
# This build is a single-page app: any path that isn't a file gets
# index.html and the client router takes it from there.
{{else}}
#
# This build writes one HTML file per page (Astro), so a path that
# matches no page is a real 404 — not the home page answering 200.
{{/if}}

# Who is asking — see "Shutdown drain" below. Docker's probe comes over
# loopback. Traefik's comes straight from Traefik with an X-Hatchkit-Drain
# header and no X-Forwarded-For: Traefik adds that header to every
# request it forwards, so a visitor can't pose as the probe.
map "$remote_addr|$http_x_hatchkit_drain|$http_x_forwarded_for" $hatchkit_probe {
    "~^(127\.0\.0\.1|::1)\|" docker;
    "~^[^|]*\|[^|]+\|$"       traefik;
    default                     "";
}
map $hatchkit_probe $hatchkit_log {
    ""      1;
    default 0;
}

server {
    listen       80;
    server_name  localhost;
    root         /usr/share/nginx/html;

    # Keeps any redirect nginx sends relative. Behind Traefik and
    # Cloudflare nginx only sees plain http, so an absolute one would
    # send visitors to http:// and cost them an extra hop back to https.
    absolute_redirect off;

    # Shutdown drain. On `docker stop` the image's entrypoint creates
    # /tmp/hatchkit-draining, a few seconds later
    # /tmp/hatchkit-draining-proxy, and waits before it stops nginx.
    # Meanwhile the health probes get a 503 — Docker's at once (Coolify
    # runs it INSIDE the container, against 127.0.0.1), Traefik's own
    # check from the second file on — so Traefik stops routing here.
    # Traefik drops a container on ONE failed check, and can take 2 s to
    # add the new one after Coolify starts this stop, hence the delay.
    # Visitors are served throughout. Without this Traefik routes here
    # until nginx has exited, and the requests caught in between fail
    # with 502 or hang into a 504. Outside a drain Traefik's probe gets a
    # 200 from here: it asks every few seconds, and needs no page for it.
    set $drain "";
    if (-f /tmp/hatchkit-draining) {
        set $drain "on-";
    }
    if (-f /tmp/hatchkit-draining-proxy) {
        set $drain "on-proxy-";
    }
    set $drain "${drain}${hatchkit_probe}";
    if ($drain ~ "^on-(proxy-)?docker$|^on-proxy-traefik$") {
        return 503;
    }
    if ($drain ~ "traefik$") {
        return 200 "serving\n";
    }
    # Neither probe needs a line in the access log every few seconds.
    access_log /var/log/nginx/access.log main if=$hatchkit_log;
{{#if spaFallback}}

    # A last path segment with a dot names a file — `/assets/index-3f2a.js`,
    # `/favicon.ico`. A missing one is a 404, never index.html: during a
    # deploy a tab still on the old build asks for chunks the new one
    # doesn't have, and a 200 of HTML under a `.js` URL is what
    # Cloudflare then caches at the edge. A client route with a dot in
    # its last segment (`/u/jane.doe`) needs a rule of its own above
    # this one.
    location ~ \.[^/]*$ {
        try_files $uri =404;
    }

    location / {
        index     index.html;
        try_files $uri $uri.html $uri/index.html /index.html;
    }
{{else}}

    location / {
        index     index.html;
        try_files $uri $uri.html $uri/index.html =404;
    }
{{/if}}

    # Served when the build has one; nginx's own 404 page otherwise.
    error_page 404 /404.html;
}
