# syntax=docker/dockerfile:1
#
# Static-site image for {{name}}.
# Built by .github/workflows/deploy.yml, pushed to GHCR, pulled by
# Coolify via docker-compose.yml. nginx serves the built bundle with
# the nginx.conf next to this file — no runtime Node, so any
# sensitive values must be build-time-only
# (baked into the static bundle) or non-sensitive.
#
# .env.production is committed to the repo dotenvx-encrypted. The
# build stage decrypts it via the dotenvx_private_key BuildKit secret
# (passed by .github/workflows/deploy.yml from the GH Actions secret
# DOTENV_PRIVATE_KEY_PRODUCTION) so `pnpm build` sees the plain values
# when it bakes them into the static output.
#
# Why BuildKit secrets and not ARG: ARG values land in `docker history`
# and the image manifest. BuildKit secrets are mounted as tmpfs at
# build time and never persist — `docker history` won't show them, the
# final image won't either. Requires BuildKit (default in modern
# Docker; the GH Actions workflow uses docker/setup-buildx-action
# which enables it).
#
# What ends up in the bundle: NEXT_PUBLIC_* / VITE_* / similar values
# that the framework explicitly inlines into client JS. What does NOT:
# any non-public values, since this static site has no runtime to
# read them.
ARG NODE_VERSION={{nodeMajor}}

FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml* ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
# `--mount=type=secret,id=dotenvx_private_key,env=DOTENV_PRIVATE_KEY_PRODUCTION`
# exposes the secret value as the env var the wrapped command reads,
# only for the duration of each RUN it's mounted into. dotenvx picks
# it up, decrypts .env.production in memory, and re-exports each
# KEY=VALUE for `pnpm build`. If the secret is missing, dotenvx
# silently skips decryption and the build would bake `encrypted:...`
# strings into asset URLs — fail fast instead.
#
# Two separate RUN steps on purpose: BuildKit dumps the entire RUN
# command into the build error when ANY step in a chained `&&` fails,
# echo strings included. Splitting the secret check off means the
# "secret not supplied" message only shows up when that's actually
# what failed — a downstream `pnpm build` failure won't drag the
# misleading echo into its error context.
RUN --mount=type=secret,id=dotenvx_private_key,env=DOTENV_PRIVATE_KEY_PRODUCTION \
    test -n "$DOTENV_PRIVATE_KEY_PRODUCTION" || { \
      echo "ERROR: dotenvx_private_key build secret not supplied. The workflow at .github/workflows/deploy.yml should pass it via 'secrets:' from the GH Actions secret DOTENV_PRIVATE_KEY_PRODUCTION." >&2; \
      exit 1; \
    }
ARG COMMIT_SHA
ENV COMMIT_SHA=$COMMIT_SHA
RUN --mount=type=secret,id=dotenvx_private_key,env=DOTENV_PRIVATE_KEY_PRODUCTION \
    pnpm dlx @dotenvx/dotenvx run -- pnpm build

# Stamp the commit next to the built bundle. nginx serves it as
# /version.json like any other static file, which is what lets the
# deploy job ask the DEPLOYED artefact what it is. Without it the
# pipeline's last assertion is "Coolify accepted my POST", and a deploy
# that silently kept the previous container reports success everywhere
# — ghcr, the Coolify dashboard and the workflow all show the new
# commit while the old bundle is still being served.
RUN mkdir -p dist \
    && printf '{"commit":"%s"}\n' "$COMMIT_SHA" > dist/version.json

FROM nginx:alpine AS runner
# Maps URLs onto the bundle: client-side routes and `.html`-less page
# URLs. The stock default.conf 404s both — see the header of nginx.conf.
# It also fails the health probe while this container drains (below).
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Shutdown drain. Coolify deploys by starting the new container, waiting
# for it to turn healthy, then running `docker stop` on this one — and
# Traefik keeps routing here until nginx has EXITED, so the requests
# caught in between fail with a 502 or hang into a 504. On SIGTERM this
# entrypoint flags the container as draining (nginx.conf then fails the
# health probe, so Docker marks it unhealthy and Traefik drops it),
# keeps serving for SHUTDOWN_DRAIN_SECONDS, then stops nginx gracefully.
#
# SHUTDOWN_DRAIN_SECONDS is timed against the health check hatchkit sets
# on the Coolify app (every 2 s, 5 retries) and has to stay under the
# 30 s `docker stop` allows. 0 turns the drain off.
COPY --chmod=755 <<'EOF' /usr/local/bin/drain-entrypoint
#!/bin/sh
flag=/tmp/hatchkit-draining
rm -f "$flag"
/docker-entrypoint.sh "$@" &
pid=$!
quit() { kill -QUIT "$pid" 2>/dev/null; }
drain() {
  if [ ! -e "$flag" ] && [ -n "${SHUTDOWN_DRAIN_SECONDS:-}" ] && [ "$SHUTDOWN_DRAIN_SECONDS" != 0 ]; then
    touch "$flag"
    echo "[drain] SIGTERM: failing the health check for ${SHUTDOWN_DRAIN_SECONDS}s so the proxy stops routing here, then shutting down"
    sleep "$SHUTDOWN_DRAIN_SECONDS"
  fi
  quit
}
trap drain TERM
trap quit INT QUIT
# `wait` returns early when a trapped signal arrives; keep waiting until
# nginx itself has exited, and exit with its status.
status=0
while kill -0 "$pid" 2>/dev/null; do
  wait "$pid"
  status=$?
done
exit "$status"
EOF
ENV SHUTDOWN_DRAIN_SECONDS={{drainSeconds}}
# The nginx image stops on SIGQUIT — nginx's graceful quit, which closes
# its listener at once. SIGTERM reaches the entrypoint's trap instead.
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/drain-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
EXPOSE 80
