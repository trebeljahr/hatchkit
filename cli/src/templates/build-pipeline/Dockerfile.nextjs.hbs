# syntax=docker/dockerfile:1
#
# Next.js + Coolify image for {{name}}.
# Built by .github/workflows/deploy.yml, pushed to GHCR, pulled by
# Coolify via docker-compose.yml.
#
# Runtime: node + `next start`. NOT nginx + static export — Next.js
# apps with any of the following features won't compile under
# `output: "export"` and need a Node runtime:
#
#   - Server Actions ("use server")
#   - Route handlers that read Request / cookies / use non-GET verbs
#   - Dynamic routes without generateStaticParams
#   - Server-side env vars without NEXT_PUBLIC_* prefixes
#
# dotenvx decrypts the committed encrypted .env.production at TWO points:
#
#   1. Build stage — uses the dotenvx_private_key BuildKit secret
#      (passed by the workflow from the GH Actions secret
#      DOTENV_PRIVATE_KEY_PRODUCTION) to decrypt in-memory before
#      running `pnpm build`. Required so NEXT_PUBLIC_* values get
#      inlined into the static client bundle. The secret is mounted
#      as tmpfs and never lands in `docker history` or any image layer.
#
#   2. Runtime CMD — `dotenvx run` reads the same .env.production and
#      decrypts again, this time using DOTENV_PRIVATE_KEY_PRODUCTION
#      from the container env (forwarded by docker-compose.yml from
#      Coolify's app env). This covers server-side values the runtime
#      reads with `process.env.X` — Server Action handlers, route
#      handlers, etc.
#
# Image base is bookworm-slim (not alpine) because Next's optional
# native deps (sharp for image optimisation) ship glibc binaries that
# don't run on Alpine's musl without a rebuild — avoiding the rebuild
# is faster and one less moving part.
ARG NODE_VERSION={{nodeMajor}}

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app

RUN corepack enable

# Install deps first (layer cache) before copying source.
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

# Two separate RUN steps on purpose: BuildKit echoes the entire RUN
# body into any failure log, so splitting the secret-presence check
# off means the "secret not supplied" message only surfaces when
# that's actually what failed — a downstream `next build` error
# won't drag the misleading echo into its context.
RUN --mount=type=secret,id=dotenvx_private_key,env=DOTENV_PRIVATE_KEY_PRODUCTION \
    test -n "$DOTENV_PRIVATE_KEY_PRODUCTION" || { \
      echo "ERROR: dotenvx_private_key build secret not supplied. The workflow at .github/workflows/deploy.yml should pass it via 'secrets:' from the GH Actions secret DOTENV_PRIVATE_KEY_PRODUCTION." >&2; \
      exit 1; \
    }

# dotenvx decrypts .env.production in memory and re-exports each
# KEY=VALUE for `pnpm build`. next build sees the plain values and
# bakes NEXT_PUBLIC_* into the static client bundle.
ARG COMMIT_SHA
ENV COMMIT_SHA=$COMMIT_SHA
RUN --mount=type=secret,id=dotenvx_private_key,env=DOTENV_PRIVATE_KEY_PRODUCTION \
    pnpm dlx @dotenvx/dotenvx run -- pnpm build

# Stamp the commit next to the export. Next serves `public/` verbatim,
# so this lands at /version.json — which is what lets the deploy job ask
# the DEPLOYED artefact what it is. Without it the pipeline's last
# assertion is "Coolify accepted my POST", and a deploy that silently
# kept the previous container reports success everywhere — ghcr, the
# Coolify dashboard and the workflow all show the new commit while the
# old bundle is still being served.
RUN mkdir -p public \
    && printf '{"commit":"%s"}\n' "$COMMIT_SHA" > public/version.json

# ---------------------------------------------------------------------------
# Runtime — `next start` on PORT={{port}}.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app

# curl for Coolify's health check. Coolify probes the container by
# running `curl … || wget … || exit 1` INSIDE it, in place of the
# HEALTHCHECK below, and bookworm-slim ships neither. Without one the
# probe can never pass: every deploy would be rolled back and the old
# container kept. With it, a deploy is a rolling update — the old
# container serves until this one is healthy.
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT={{port}}

# Bring across everything `next start` needs to serve the app. The
# encrypted .env.production travels with the image so dotenvx can
# decrypt at startup; the matching private key arrives via the
# container env (set by Coolify, see docker-compose.yml).
#
# Glob-matches both `next.config.ts` and `next.config.{js,mjs,cjs}`.
# The build leaves `.env.production` in /app because the build context
# copied it in at `COPY . .` above.
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/package.json ./
COPY --from=build /app/pnpm-lock.yaml ./
COPY --from=build /app/next.config.* ./
COPY --from=build /app/.env.production ./
COPY --from=build /app/node_modules ./node_modules

# Shutdown drain. Coolify deploys by starting the new container, waiting
# for it to turn healthy, then running `docker stop` on this one — and
# Traefik keeps routing here until the process has EXITED, so requests
# caught in between fail with a 502 or hang into a 504. drain.cjs, loaded
# ahead of `next start`, fails the health probe on SIGTERM (so Docker marks
# this container unhealthy and Traefik drops it), keeps serving for
# SHUTDOWN_DRAIN_SECONDS, then lets Next.js shut down as usual. Its
# header has the details.
#
# SHUTDOWN_DRAIN_SECONDS is timed against the health check hatchkit sets
# on the Coolify app (every 2 s, 5 retries) and has to stay under the
# 30 s `docker stop` allows. 0 turns the drain off.
COPY <<'EOF' /usr/local/lib/drain.cjs
{{{drainPreload}}}
EOF
# dotenvx forwards SIGTERM to the server and SIGKILLs it 5 s later —
# mid-drain. This entrypoint hands SIGTERM to the server itself instead.
COPY --chmod=755 <<'EOF' /usr/local/bin/drain-entrypoint
{{{drainEntrypoint}}}
EOF
ENV SHUTDOWN_DRAIN_SECONDS={{drainSeconds}}
ENTRYPOINT ["/usr/local/bin/drain-entrypoint"]

EXPOSE {{port}}

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:{{port}}/',r=>{process.exit(r.statusCode<400?0:1)}).on('error',()=>process.exit(1))"

# dotenvx decrypts .env.production at startup using
# DOTENV_PRIVATE_KEY_PRODUCTION from the container env (forwarded by
# Coolify via docker-compose.yml). next start then sees XAI_API_KEY,
# NEXT_PUBLIC_*, etc. and binds to PORT={{port}} from the ENV above.
# Next's own bin script rather than the `.bin/next` shim, so `node` can
# load the drain first.
CMD ["./node_modules/.bin/dotenvx", "run", "--", "node", "--require", "/usr/local/lib/drain.cjs", "./node_modules/next/dist/bin/next", "start"]
