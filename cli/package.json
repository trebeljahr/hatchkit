{
  "name": "hatchkit",
  "version": "0.2.18",
  "packageManager": "pnpm@10.33.2",
  "description": "Interactive CLI for scaffolding full-stack projects and provisioning observability/email clients",
  "license": "MIT",
  "homepage": "https://hatchkit.trebeljahr.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/hatchkit.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/trebeljahr/hatchkit/issues"
  },
  "funding": "https://ricos.site/donate?from=hatchkit",
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "coolify",
    "hetzner",
    "terraform",
    "dotenvx",
    "full-stack",
    "mlops"
  ],
  "type": "module",
  "bin": {
    "hatchkit": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @hatchkit/dev-shared run build && tsc && node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/test.mjs",
    "test:identifiers": "node scripts/test.mjs test-identifiers.ts",
    "test:extension": "node scripts/test.mjs test-extension.ts",
    "test:client-core-shared-exports": "node scripts/test.mjs test-client-core-shared-exports.ts",
    "test:feature-contract": "node scripts/test.mjs test-feature-contract.ts",
    "test:help-safety": "node scripts/test.mjs test-help-safety.ts",
    "test:routing": "node scripts/test.mjs test-routing.ts",
    "test:image-runtime": "node scripts/test.mjs test-image-runtime.ts",
    "test:project-isolation": "node scripts/test.mjs test-project-isolation.ts",
    "test:shutdown-drain": "node scripts/test.mjs test-shutdown-drain.ts",
    "test:deploy-verification": "node scripts/test.mjs test-deploy-verification.ts",
    "test:static-nginx": "node scripts/test.mjs test-static-nginx.ts",
    "test:doctor-pull-policy": "node scripts/test.mjs test-doctor-pull-policy.ts",
    "test:doctor-nginx-config": "node scripts/test.mjs test-doctor-nginx-config.ts",
    "test:doctor-env-keys": "node scripts/test.mjs test-doctor-env-keys.ts",
    "test:coolify-patch-limits": "node scripts/test.mjs test-coolify-patch-limits.ts",
    "test:coolify-db-network": "node scripts/test.mjs test-coolify-db-network.ts",
    "test:force-domain-override": "node scripts/test.mjs test-force-domain-override.ts",
    "test:adopt-manifest": "node scripts/test.mjs test-adopt-manifest.ts",
    "test:keys-rotate": "node scripts/test.mjs test-keys-rotate.ts",
    "test:secrets-rotate": "node scripts/test.mjs test-secrets-rotate.ts",
    "test:secrets-rotate-providers": "node scripts/test.mjs test-secrets-rotate-providers.ts",
    "test:secrets-global": "node scripts/test.mjs test-secrets-global.ts",
    "test:secret-hygiene": "node scripts/test.mjs test-secret-hygiene.ts",
    "test:signing-rewriter": "node scripts/test.mjs test-signing-rewriter.ts",
    "test:signing-asc": "node scripts/test.mjs test-signing-asc.ts",
    "test:auth-account-security": "node scripts/test.mjs test-auth-account-security.ts",
    "test:signing-stepper": "node scripts/test.mjs test-signing-stepper.ts",
    "test:signing-workflow-writer": "node scripts/test.mjs test-signing-workflow-writer.ts",
    "test:release-channels": "node scripts/test.mjs test-release-channels.ts",
    "test:release-runtime": "node scripts/test.mjs test-release-runtime.ts",
    "test:release-policy": "node scripts/test.mjs test-release-policy.ts",
    "test:release-setup": "node scripts/test.mjs test-release-setup.ts",
    "test:mobile-build": "node scripts/test.mjs test-mobile-build.ts",
    "test:mobile-release": "node scripts/test.mjs test-mobile-release.ts",
    "test:native-overlay": "node scripts/test.mjs test-native-overlay.ts",
    "test:mobile-scaffold": "node scripts/test.mjs test-mobile-scaffold.ts",
    "test:client-core": "node scripts/test.mjs test-client-core.ts",
    "test:device-grant": "node scripts/test.mjs test-device-grant.ts",
    "test:raycast": "node scripts/test.mjs test-raycast.ts",
    "test:mcp": "node scripts/test.mjs test-mcp.ts",
    "test:lockfile": "node scripts/test.mjs test-lockfile.ts",
    "test:server-migrations": "node scripts/test.mjs test-server-migrations.ts",
    "test:scheduler": "node scripts/test.mjs test-scheduler.ts",
    "test:public-api": "node scripts/test.mjs test-public-api.ts",
    "test:server-platform": "node scripts/test.mjs test-server-platform.ts",
    "test:i18n-writer": "node scripts/test.mjs test-i18n-writer.ts",
    "test:i18n-parity": "node scripts/test.mjs test-i18n-parity.ts",
    "test:i18n-pseudo": "node scripts/test.mjs test-i18n-pseudo.ts",
    "test:i18n-rewriter": "node scripts/test.mjs test-i18n-rewriter.ts",
    "test:i18n-update": "node scripts/test.mjs test-i18n-update.ts",
    "test:i18n-seams": "node scripts/test.mjs test-i18n-seams.ts",
    "typecheck": "tsc --noEmit",
    "dev:typecheck": "tsc --noEmit --watch --preserveWatchOutput",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "install-local": "pnpm run build && npm install -g .",
    "changelog": "node scripts/print-changelog.mjs",
    "release": "pnpm run release:patch",
    "release:patch": "node scripts/release-prep.mjs && node scripts/release-bump.mjs patch && pnpm run _release:finish",
    "release:minor": "node scripts/release-prep.mjs && node scripts/release-bump.mjs minor && pnpm run _release:finish",
    "release:major": "node scripts/release-prep.mjs && node scripts/release-bump.mjs major && pnpm run _release:finish",
    "_release:finish": "pnpm run build && pnpm run typecheck && git push --follow-tags && node scripts/release-packages.mjs && npm publish --access public && npm install -g .",
    "prepublishOnly": "pnpm run build",
    "test:token-client-auth": "node scripts/test.mjs test-token-client-auth.ts",
    "test:workspaces": "node scripts/test.mjs test-workspaces.ts",
    "test:desktop-shell": "node scripts/test.mjs test-desktop-shell.ts",
    "test:feature-matrix": "node scripts/test.mjs test-feature-matrix.ts",
    "test:update-flags": "node scripts/test.mjs test-update-flags.ts",
    "test:dev-launcher": "node scripts/test.mjs test-dev-launcher.ts",
    "test:verified-deploy": "node scripts/test.mjs test-verified-deploy.ts",
    "test:topology-guidance": "node scripts/test.mjs test-topology-guidance.ts",
    "test:env-agreement": "node scripts/test.mjs test-env-agreement.ts",
    "test:selfhost": "node scripts/test.mjs test-selfhost.ts",
    "test:docs-in-client": "node scripts/test.mjs test-docs-in-client.ts",
    "test:deploy-recovery": "node scripts/test.mjs test-deploy-recovery.ts",
    "test:error-reporting": "node scripts/test.mjs test-error-reporting.ts",
    "test:lint-gate": "node scripts/test.mjs test-lint-gate.ts",
    "test:ses-feedback": "node scripts/test.mjs test-ses-feedback.ts",
    "test:keychain-isolation": "node scripts/test.mjs test-keychain-isolation.ts",
    "test:ses-project-sender": "node scripts/test.mjs test-ses-project-sender.ts",
    "test:ses-project-runtime": "node scripts/test.mjs test-ses-project-runtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1048.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.1048.0",
    "@aws-sdk/client-sesv2": "^3.1048.0",
    "@aws-sdk/client-sns": "^3.1048.0",
    "@aws-sdk/client-sts": "^3.1048.0",
    "@dotenvx/dotenvx": "^1.61.2",
    "@hatchkit/dev-shared": "workspace:*",
    "@inquirer/core": "^10.3.0",
    "@inquirer/figures": "^1.0.0",
    "@inquirer/prompts": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.3.0",
    "conf": "^13.0.0",
    "eciesjs": "^0.4.18",
    "execa": "^9.0.0",
    "handlebars": "^4.7.8",
    "keytar": "^7.9.0",
    "ora": "^8.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "zod": "4.4.3"
  }
}
