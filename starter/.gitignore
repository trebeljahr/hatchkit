.next/
.turbo/

# Electron bundle: esbuild turns electron/src/*.ts into electron/dist/main.js
# and electron/dist/preload.js (scripts/build-desktop.mjs). Covered by the
# `dist/` rule above, which matches at any depth.

# Electron-builder release artifacts
release/

# Generated desktop icons (source of truth is build/icon.png)
build/icon.icns
build/icon.ico
build/icons/

# ── Capacitor native projects: COMMITTED, with holes ──────────────────
#
# `ios/` and `android/` are both tracked. They are generated by
# `pnpm cap:add:ios` / `pnpm cap:add:android`, but a handful of edits live
# ONLY in those trees and nowhere else in the repo:
#
#   · the iOS ATS exception for a local http API
#   · the supported-orientation set
#   · the Android debug-only cleartext network_security_config.xml
#   · versionName / MARKETING_VERSION, wired to the root package.json
#   · the optional, environment-driven Android release signing config
#
# scripts/cap-add.mjs applies all of them after `cap add` so nobody has to
# remember, but the result still has to be committed: a fresh checkout must
# build the real app without a generator run, and
# .github/workflows/mobile-release.yml assumes both trees exist while never
# running `cap add`.
#
# GENERATED BUT TRACKED — rewritten by every `pnpm build:mobile`, so a diff
# there after a build is normal. Commit it when the plugin set changed:
#   ios/App/CapApp-SPM/Package.swift
#   android/capacitor.settings.gradle
#   android/app/capacitor.build.gradle
# Plus the Assets.xcassets catalog and the Android res/ icon and splash
# sets, regenerated by `pnpm mobile:assets` from resources/.
#
# GENERATED AND NOT TRACKED — the holes below. A checkout that has never
# run `pnpm build:mobile` has none of them, and therefore CANNOT be opened
# in Xcode or Gradle. Build first.
ios/App/App/public/
ios/App/build/
ios/App/DerivedData/
ios/App/.swiftpm/
ios/App/CapApp-SPM/.build/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/
android/.gradle/
android/build/
android/app/build/
android/local.properties
# The release keystore is a credential. Signing is environment-driven and
# optional (android/app/build.gradle), so a checkout without this file
# still builds — unsigned.
android/app/release.keystore

# Next.js static export output. One directory per shell on purpose — a shared
# one means a Playwright run can silently be installed as the app, and each
# export bakes in its own NEXT_PUBLIC_API_URL, so packaging whatever happens to
# be in out/ ships an app bound to the wrong server.
# out/         — the web build (`pnpm build:client`) and Playwright
# out-desktop/ — the Electron export (`pnpm build:desktop`)
# out-mobile/  — the Capacitor export (`pnpm build:mobile`)
packages/client/out/
packages/client/out-desktop/
packages/client/out-mobile/

# Environment (committed: .env.example, .env.development, AND
#              .env.production — because production values are
#              encrypted via dotenvx, not plaintext).
#
# .env.keys must NEVER be committed — it contains the private keys
# that decrypt the encrypted values in .env.production.
.env
.env.local
.env.keys
.env.*.local

# The negations below are load-bearing, not decoration.
#
# Leaving `.env.production` merely *unlisted* here is not enough to
# commit it. Git also consults the user's global excludes file
# (`core.excludesFile`, usually ~/.config/git/ignore), and the widely
# copy-pasted version of that file lists `.env.development` and
# `.env.production`. A repo .gitignore only overrides a global pattern
# when it has a matching pattern of its own — absence loses, so both
# files were silently never committed, on every machine with that
# global ignore. An explicit `!` re-includes them and wins.
#
# This matters because the encrypted `.env.production` is hatchkit's
# at-rest store for production values: `hatchkit secrets rotate` writes
# into it and `hatchkit sync` reads it to push resolved values into
# Coolify. A file that never reaches git is a store that only exists on
# whichever laptop last wrote it.
!.env.development
!.env.production

