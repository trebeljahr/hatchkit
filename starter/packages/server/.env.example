# Server port
PORT=5000

# Frontend URL for CORS and redirects. This is the *client* origin, not
# the server's — getTrustedOrigins() feeds it straight to better-auth and
# CORS, so it must be the exact origin the browser loads the app from.
# `hatchkit create` rewrites this to https://<domain> in a generated
# project: single-domain routing serves the client from the bare domain
# and mounts the API under /api on that same host, so this is the same
# origin as the client's NEXT_PUBLIC_API_URL — no api.<domain> subdomain,
# no port. Local dev values live in .env.development, where FRONTEND_URL
# does carry the client's dev port.
FRONTEND_URL=http://localhost:3000

# Additional CORS / auth origins, comma-separated. Set this for native
# clients (desktop/mobile). Examples:
#   Capacitor iOS+Android: capacitor://localhost,https://localhost
#   Custom Electron proto: app://-
# Electron file:// sends Origin: null and can't be trusted with credentials;
# register a custom protocol in electron/main.ts and add it here instead.
# TRUSTED_ORIGINS=

# The origins of the published store clients: the phone shells
# (capacitor://localhost on iOS, https://localhost on Android), the desktop
# shell (app://-) and a published browser extension (chrome-extension://<id>).
# Comma-separated, parsed exactly like TRUSTED_ORIGINS above. The self-host
# compose file (docker-compose.selfhost.yml) fills this in from the project's
# own features, so whoever runs the stack can read off which clients their
# instance accepts.
# STORE_CLIENT_ORIGINS=

# Whether STORE_CLIENT_ORIGINS is appended to the trusted list. ON unless you
# set it to false. That default is deliberate: those builds let a person type
# in any server's address, so somebody who installs the published app and
# points it at their own server expects it to work. The alternative is a
# refusal they cannot diagnose — better-auth answers 403 INVALID_ORIGIN before
# the password is checked, with nothing in the browser console naming the
# cause, and curl cannot reproduce it (a real browser sends Sec-Fetch-* headers
# and those force origin validation; curl sends none). It costs nothing on a
# deploy that ships no store client, because the list it turns on is empty.
# TRUST_STORE_APPS=false

# Trust a browser extension whose origin nobody can list in advance. Firefox
# gives every install its own moz-extension://<uuid> address, and Safari does
# the same with safari-web-extension://<uuid>, so those origins are trusted by
# their SHAPE — and only for requests that carry no session cookie. Such a
# client signs in with a bearer token, and its CORS answers never allow
# credentials, which is what keeps some other extension in the same browser
# from riding your signed-in session. Unset follows TRUST_STORE_APPS; set it
# explicitly to accept the store apps and still refuse this rule, or the other
# way round. See src/auth/extension-origins.ts.
# TRUST_EXTENSION_ORIGINS=true

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/starter-dev

# Redis (optional — used for distributed features)
# REDIS_URL=redis://127.0.0.1:6379

# better-auth
BETTER_AUTH_SECRET=change-me-in-production-use-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional — leave empty to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe (optional — leave empty to disable payments).
# Hatchkit auto-fills these per project: sandbox creds → .env.development,
# live creds → .env.production (encrypted). STRIPE_WEBHOOK_SECRET is
# minted by hatchkit at create/adopt time using a master restricted key.
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Listmonk + SES (optional — falls back to console logging).
# Hatchkit fills these in via `hatchkit add <project> listmonk-ses`:
# the SES identity is published to Cloudflare DNS, Listmonk gets the
# live + test lists and transactional + campaign templates, and the
# server reads them via env at send time.
# LISTMONK_URL=https://listmonk.example.com
# LISTMONK_API_USER=hatchkit
# LISTMONK_API_TOKEN=...
# LISTMONK_FROM_EMAIL=noreply@mail.yourdomain.com
# LISTMONK_FROM=Your Project <noreply@mail.yourdomain.com>
# LISTMONK_LIVE_LIST_ID=1
# LISTMONK_TEST_LIST_ID=2
# LISTMONK_TX_TEMPLATE_ID=1
# LISTMONK_CAMPAIGN_TEMPLATE_ID=2
# LISTMONK_TEST_RECIPIENT=you@example.com   # default target for newsletter:test-tx / welcome / verify

# S3-compatible storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET_NAME=starter-dev
S3_PUBLIC_URL=http://127.0.0.1:9000/starter-dev
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=hatchkit-dev
AWS_SECRET_ACCESS_KEY=hatchkit-dev

# Sentry/GlitchTip (optional)
# SENTRY_DSN=https://key@glitchtip.example.com/1
