{
  "name": "@starter/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch --clear-screen=false --exclude \"../../node_modules/**\" src/index.ts",
    "test": "pnpm --filter @starter/core run build && node --import tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@sentry/node": "^11.11.0",
    "@starter/core": "workspace:*",
    "@starter/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "better-auth": "~1.7.15",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "stripe": "^23.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "@aws-sdk/client-sesv2": "3.1048.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.22.0",
    "typescript": "^7.0.2"
  }
}
