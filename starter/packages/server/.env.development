# Local development defaults (committed to repo)
# PORT and FRONTEND_URL are rewritten per project by `hatchkit create`
# (see applyPorts in cli/src/scaffold/starter-files.ts) so every scaffold
# gets its own collision-free pair.
#
# FRONTEND_URL is the *client* origin, not the server's —
# getTrustedOrigins() feeds it straight to better-auth and CORS, so locally
# it must match the origin Next is actually served on: the same host and
# the PORT set in packages/client/.env.development. Move the client's dev
# port and this line has to move with it, or cookie auth silently fails
# against an origin no dev client ever uses.
# (Production is different: there FRONTEND_URL is the bare https://<domain>
# with no port — see .env.example.)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/starter-dev
BETTER_AUTH_SECRET=dev-secret-do-not-use-in-production
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=starter-dev
S3_PUBLIC_URL=http://127.0.0.1:9000/starter-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=hatchkit-dev
AWS_SECRET_ACCESS_KEY=hatchkit-dev
