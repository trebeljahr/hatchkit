# terraform.tfvars.example — Copy to terraform.tfvars and fill in your values.
#
# Sensitive values (hcloud_token) should be set via environment variables:
#   export TF_VAR_hcloud_token="your-token-here"

server_name     = "hardened-vps"
server_type     = "cx33"        # 4 vCPU, 8 GB RAM (shared x86)
server_location = "nbg1"        # Nuremberg

# Either upload a key...
ssh_public_key  = "ssh-ed25519 AAAA... you@machine"
ssh_key_name    = "deploy-key"
# ...or reuse one the project already holds (Hetzner rejects duplicates):
# existing_ssh_key_name = "my-laptop"

firewall_enabled = true
# Public SSH only from your own address while Ansible runs; [] once Tailscale SSH works.
# ssh_source_ips = ["203.0.113.7/32"]
tailscale_direct_udp = true
# Origin behind Cloudflare only (curl https://www.cloudflare.com/ips-v4 and ips-v6):
# http_source_ips = ["173.245.48.0/20", "103.21.244.0/22", …, "2400:cb00::/32", …]
backups              = false
